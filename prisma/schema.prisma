generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  super_admin
  admin
  user
  taxi
  taxi_partner
  hotel_manager
  guide
  /// Guide panel operator. `guide` is the older value for the same panel;
  /// both are accepted (see src/shared/roles.ts GUIDE_PANEL_ROLES).
  guide_partner
  restaurant_manager
  home_stay_partner
  /// Feedback & Support inbox agent
  support
  /// Hotel frontline staff (Staff PWA)
  cleaner
  receptionist
  waiter
  hotel_staff
}

/// Staff Ops — shift lifecycle (7shifts / Unifocus pattern)
enum StaffShiftStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum StaffOpsTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum StaffOpsTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum StaffChatThreadKind {
  DEPARTMENT
  DIRECT
  ANNOUNCEMENT
}

/// Unified support inbox channel (maps UI: hotel / tour / transport).
enum FeedbackChannel {
  hotel
  guide
  taxi
  homestay
  direct
}

enum FeedbackTicketStatus {
  OPEN
  ANSWERED
  ESCALATED
  CLOSED
}

/// Support live chat — who the conversation is with.
enum SupportPartyType {
  hotel
  homestay
  taxi
  guide
  customer
}

enum SupportThreadStatus {
  OPEN
  CLOSED
}

enum SupportMemberRole {
  AGENT
  PARTY
}

enum FeedbackSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum PartnerType {
  taxi
  hotel
  guide
  restaurant
  agency
}

enum PartnerStatus {
  pending
  approved
  rejected
}

enum HotelStatus {
  draft
  active
  suspended
}

enum BookingSource {
  SAFARTRIP
  DIRECT
  WALK_IN
  PHONE
  CORPORATE
  ADMIN
  RECEPTION
  /// Inbound from channel manager / OTA adapters
  BOOKING_COM
  EXPEDIA
  AIRBNB
}

enum BookingStatus {
  PENDING
  HELD
  PAID
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  REFUNDED
  NO_SHOW
  EXPIRED
}

enum BookingEventActor {
  USER
  PARTNER
  SYSTEM
  PAYME
  CLICK
}

enum RoomOperationalStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  MAINTENANCE
  BLOCKED
}

enum RoomAssignmentStatus {
  ACTIVE
  RELEASED
  CANCELLED
}

enum TravelPlanStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
}

enum TravelItemType {
  HOTEL
  HOMESTAY
  TAXI
  GUIDE
}

enum TaxiServiceType {
  INTERCITY_TRANSFER
  HOTEL_TRANSFER
  TOUR_DAILY_TRANSPORT
}

enum TaxiVehicleCategory {
  STANDARD
  COMFORT
  MINIVAN
  PREMIUM
}

enum TaxiOrderStatus {
  PENDING
  ACCEPTED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTE
}

enum TaxiOrderCancelledBy {
  CUSTOMER
  DRIVER
  SYSTEM
}

enum DriverEarningStatus {
  PENDING
  SETTLED
}

enum PartnerEarningType {
  HOTEL
  HOMESTAY
  GUIDE
  TAXI
}

/// Who receives net payout for inventory / a booking.
/// PLATFORM = company-operated (no PartnerEarning); PARTNER = dual-write PE + payable.
enum PayoutOwnerType {
  PLATFORM
  PARTNER
}

enum PartnerEarningStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentProvider {
  CLICK
  PAYME
  UZUM
  MANUAL
  MOCK
}

enum PaymentStatus {
  INITIATED
  PENDING
  /// Money captured by the PSP, but a linked booking could not be confirmed, so
  /// the ledger holds less than the captured amount. Ops must resolve; never
  /// treat as revenue.
  PENDING_REVIEW
  SUCCESS
  FAILED
  CANCELLED
}

enum HomeStayListingStatus {
  PENDING
  ACTIVE
  INACTIVE
  REJECTED
  BLOCKED
}

enum HomeStayAvailabilityReason {
  BOOKED
  HOST_BLOCKED
  MAINTENANCE
}

enum HomeStayBookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  COMPLETED
  CANCELLED
  DISPUTE
}

enum GuideCategory {
  CITY_TOUR
  NATURE
  HISTORY
  ADVENTURE
  FOOD
  CUSTOM
}

enum GuideListingStatus {
  PENDING
  ACTIVE
  INACTIVE
  REJECTED
  BLOCKED
}

enum GuideBookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTE
}

enum GuideBookingCancelledBy {
  GUIDE
  CUSTOMER
  SYSTEM
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model User {
  id         String   @id @default(cuid())
  first_name String
  last_name  String
  email      String   @unique
  phone      String   @unique
  password   String
  role       Role     @default(user)
  isBlocked  Boolean  @default(false)
  /// Set when an identity provider proved ownership of `email`. A password-only
  /// signup never proves it, so those credentials lose to a verified Google login.
  emailVerifiedAt DateTime?
  /// Google `sub`, bound on first verified Google login.
  googleId   String?  @unique
  expoPushToken String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  travelPlans          TravelPlan[]
  homeStayPartner      HomeSayPartner?
  homeStayListings     HomeStayListing[]
  homeStayBookings     HomeStayBooking[]
  homeStayReviews      HomeStayReview[]
  homeStayBookingLogs  HomeStayBookingLog[]
  driverProfile        DriverProfile?
  taxiVehicles         Vehicle[]
  taxiOrdersAsCustomer TaxiOrder[]          @relation("TaxiOrderCustomer")
  taxiOrdersAsDriver   TaxiOrder[]          @relation("TaxiOrderDriver")
  taxiOrderLogs        TaxiOrderLog[]
  taxiReviewsGiven     TaxiReview[]         @relation("TaxiReviewCustomer")
  taxiReviewsReceived  TaxiReview[]         @relation("TaxiReviewDriver")
  driverEarnings       DriverEarning[]
  guideListings        GuideListing[]       @relation("GuideHost")
  guideAvailabilities  GuideAvailability[]  @relation("GuideAvailabilityGuide")
  guideBlockedSlots    GuideBlockedSlot[]   @relation("GuideBlockedSlotGuide")
  guideBookingsAsGuest GuideBooking[]       @relation("GuideBookingGuest")
  guideBookingsAsGuide GuideBooking[]       @relation("GuideBookingGuide")
  guideReviewsGiven    GuideReview[]        @relation("GuideReviewGuest")
  guideReviewsReceived GuideReview[]        @relation("GuideReviewGuide")
  guideBookingLogs     GuideBookingLog[]

  feedbackTicketsAssigned FeedbackTicket[] @relation("FeedbackTicketAssignee")
  feedbackRepliesAuthored FeedbackReply[]  @relation("FeedbackReplyAuthor")

  staffChatMemberships StaffChatMember[]
  staffChatMessages    StaffChatMessage[]  @relation("StaffChatMessageAuthor")
  staffCourseEnrollments StaffCourseEnrollment[]
  staffOpsTasksCreated StaffOpsTask[]      @relation("StaffOpsTaskCreator")

  supportThreadsOwned      SupportThread[]       @relation("SupportThreadParty")
  supportThreadMemberships SupportThreadMember[]
  supportMessagesAuthored  SupportMessage[]      @relation("SupportMessageAuthor")

  hotelBookingsAsGuest HotelBooking[] @relation("HotelBookingGuestUser")

  partnerProfile Partner?
  hotelStaff     HotelStaff?
  partnerEarnings PartnerEarning[] @relation("PartnerEarnings")
  paymeBookings  Booking[]          @relation("PaymeBookings")
}

model HomeSayPartner {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings HomeStayListing[]
}

model Partner {
  id           String        @id @default(cuid())
  type         PartnerType
  status       PartnerStatus @default(pending)
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName  String?
  bio          String?       @db.Text
  contactEmail String?
  contactPhone String?
  meta         Json?
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  hotel         Hotel?
  taxiServices  TaxiService[]
  guideListings GuideListing[]

  @@index([status, type])
}

model TaxiService {
  id          String          @id @default(cuid())
  partnerId   String
  partner     Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  title       String
  serviceType TaxiServiceType
  price       Decimal         @db.Decimal(12, 2)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  taxiOrders  TaxiOrder[]

  @@index([serviceType, isActive])
  @@index([partnerId, isActive])
}

model Vehicle {
  id          String              @id @default(cuid())
  driverId    String
  driver      User                @relation(fields: [driverId], references: [id], onDelete: Cascade)
  make        String
  model       String
  color       String
  plateNumber String              @unique
  year        Int
  category    TaxiVehicleCategory
  images      Json                @default("[]")
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  taxiOrders TaxiOrder[]

  @@index([driverId, isActive])
  @@index([category, isActive])
}

model DriverProfile {
  id            String   @id @default(cuid())
  driverId      String   @unique
  driver        User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  licenseNumber String
  licenseExpiry DateTime
  rating        Float    @default(5.0)
  totalTrips    Int      @default(0)
  isOnline      Boolean  @default(false)
  isVerified    Boolean  @default(false)
  currentLat    Float?
  currentLng    Float?
  lastLat        Float?
  lastLng        Float?
  lastLocationAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model GuideListing {
  id               String             @id @default(cuid())
  partnerId        String
  partner          Partner            @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  hostId           String
  host             User               @relation("GuideHost", fields: [hostId], references: [id], onDelete: Cascade)
  /// PLATFORM = company-operated listing (no PartnerEarning on payment).
  ownerType        PayoutOwnerType    @default(PARTNER)
  title            String
  description      String
  meetingPoint     String?
  language         String
  languages        Json               @default("[]")
  category         GuideCategory
  region           String?
  duration         String?
  pricePerDay      Decimal            @db.Decimal(12, 2)
  pricePerHour     Decimal            @db.Decimal(10, 2)
  minHours         Int
  maxHours         Int
  maxGroupSize     Int
  images           Json               @default("[]")
  status           GuideListingStatus @default(PENDING)
  verificationNote String?
  rating           Float              @default(5.0)
  totalBookings    Int                @default(0)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  availabilities GuideAvailability[]
  blockedSlots   GuideBlockedSlot[]
  bookings       GuideBooking[]
  reviews        GuideReview[]

  @@index([partnerId, isActive])
  @@index([hostId, status])
  @@index([status, category])
  @@index([region, status])
  @@index([isActive, language])
}

model GuideAvailability {
  id          String       @id @default(cuid())
  listingId   String
  listing     GuideListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  guideId     String
  guide       User         @relation("GuideAvailabilityGuide", fields: [guideId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  startTime   String
  endTime     String
  isAvailable Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([guideId, dayOfWeek])
  @@index([listingId, dayOfWeek, isAvailable])
  @@index([guideId, dayOfWeek, isAvailable])
}

model GuideBlockedSlot {
  id        String       @id @default(cuid())
  listingId String
  listing   GuideListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  guideId   String
  guide     User         @relation("GuideBlockedSlotGuide", fields: [guideId], references: [id], onDelete: Cascade)
  date      DateTime
  startTime String?
  endTime   String?
  note      String?
  createdAt DateTime     @default(now())

  @@index([listingId, date])
  @@index([guideId, date])
}

model GuideBooking {
  id                 String                   @id @default(cuid())
  listingId          String
  listing            GuideListing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  guideId            String
  guide              User                     @relation("GuideBookingGuide", fields: [guideId], references: [id], onDelete: Cascade)
  travelPlanId       String?
  travelPlan         TravelPlan?              @relation(fields: [travelPlanId], references: [id], onDelete: SetNull)
  guestId            String
  guest              User                     @relation("GuideBookingGuest", fields: [guestId], references: [id], onDelete: Cascade)
  date               DateTime
  startTime          String
  endTime            String
  hours              Int
  groupSize          Int
  hourlyRate         Decimal                  @db.Decimal(10, 2)
  totalPrice         Decimal                  @db.Decimal(10, 2)
  priceSnapshot      Json
  meetingPoint       String?
  status             GuideBookingStatus       @default(PENDING)
  cancelledBy        GuideBookingCancelledBy?
  cancellationReason String?
  guestNote          String?
  guideNote          String?
  /// Stamped from GuideListing.ownerType at successful payment.
  payoutOwnerType    PayoutOwnerType          @default(PARTNER)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  review GuideReview?
  logs   GuideBookingLog[]

  @@index([listingId, status])
  @@index([guideId, status])
  @@index([guestId, status])
  @@index([travelPlanId, status])
  @@index([date, status])
}

model GuideBookingLog {
  id         String       @id @default(cuid())
  bookingId  String
  booking    GuideBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole  String
  fromStatus String
  toStatus   String
  note       String?
  createdAt  DateTime     @default(now())

  @@index([bookingId, createdAt])
  @@index([actorId])
}

model GuideReview {
  id        String       @id @default(cuid())
  bookingId String       @unique
  booking   GuideBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  guestId   String
  guest     User         @relation("GuideReviewGuest", fields: [guestId], references: [id], onDelete: Cascade)
  guideId   String
  guide     User         @relation("GuideReviewGuide", fields: [guideId], references: [id], onDelete: Cascade)
  listingId String
  listing   GuideListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime     @default(now())

  @@index([guestId])
  @@index([guideId, rating])
  @@index([listingId, rating])
}

model Hotel {
  id           String          @id @default(cuid())
  partnerId    String          @unique
  partner      Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  /// PLATFORM = company-operated inventory (no PartnerEarning on payment).
  ownerType    PayoutOwnerType @default(PARTNER)
  status       HotelStatus     @default(draft)
  name         String
  totalRooms   Int             @default(20)
  city         String?
  address      String?
  latitude     Float?
  longitude    Float?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  bookings            HotelBooking[]
  paymeBookings       Booking[]           @relation("PaymeBookings")
  roomTypes           RoomType[]
  rooms               PhysicalRoom[]
  guestProfiles       GuestProfile[]
  hotelGuests         HotelGuest[]
  staff               HotelStaff[]
  inventoryItems      InventoryItem[]
  inventoryCategories InventoryCategory[]
  menuItems           MenuItem[]
  restaurantOrders    RestaurantOrder[]
  feedbacks           GuestFeedback[]
  staffShifts         StaffShift[]
  staffOpsTasks       StaffOpsTask[]
  staffChatThreads    StaffChatThread[]
  staffCourses        StaffCourse[]
  integrations        HotelIntegration[]
  invoices            HotelInvoice[]
  channelRoomMappings ChannelRoomMapping[]
  channelSyncJobs     ChannelSyncJob[]
  channelReservations ChannelReservationInbox[]

  @@index([status])
  @@index([latitude, longitude])
}

model HotelBooking {
  id              String                  @id @default(cuid())
  hotelId         String
  /// Restrict: bookings are financial history. Deactivate a hotel, never delete
  /// one out from under its bookings, folio items and ledger attribution.
  hotel           Hotel                   @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  roomTypeId      String?
  roomType        RoomType?               @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  guestId         String?
  guest           HotelGuest?             @relation(fields: [guestId], references: [id], onDelete: SetNull)
  /// Booking owner on the SafarTrip side. Authorization SoT for guest-facing APIs —
  /// never match a booking to a user by name/phone.
  userId          String?
  user            User?                   @relation("HotelBookingGuestUser", fields: [userId], references: [id], onDelete: SetNull)
  guestName       String
  guestPhone      String?
  passportData    String?                 @db.Text
  nationality     String?
  birthDate       DateTime?
  checkInDate     DateTime
  checkOutDate    DateTime
  roomCount       Int                     @default(1)
  totalAmount     Decimal                 @db.Decimal(12, 2)
  paidAmount      Decimal                 @default(0) @db.Decimal(12, 2)
  source          BookingSource           @default(SAFARTRIP)
  status          BookingStatus           @default(PENDING)
  /// Soft hold deadline for HELD bookings (15 minutes). Cleared after payment confirm.
  holdExpiresAt   DateTime?
  /// Real FK to TravelPlan (replaces fragile `note contains` linkage).
  travelPlanId    String?
  travelPlan      TravelPlan?             @relation(fields: [travelPlanId], references: [id], onDelete: SetNull)
  note            String?
  /// Opaque quote breakdown from RatesService (tiyin line items).
  pricingSnapshot Json?
  /// Snapshot of cancellation policy at book time.
  cancellationPolicyId String?
  cancellationPolicy   CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id], onDelete: SetNull)
  /// Stamped from Hotel.ownerType at successful payment (payout routing).
  payoutOwnerType      PayoutOwnerType         @default(PARTNER)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  roomAssignments      BookingRoomAssignment[]
  guests               BookingGuest[]
  folioItems           FolioItem[]
  payments             HotelPayment[]
  events               BookingEvent[]

  @@index([hotelId, checkInDate])
  @@index([hotelId, status])
  @@index([roomTypeId])
  @@index([guestId])
  @@index([status, holdExpiresAt])
  @@index([cancellationPolicyId])
  @@index([payoutOwnerType])
  @@index([travelPlanId])
  @@index([userId, status])
}

/// Audit trail for HotelBooking status transitions (immutable append-only).
model BookingEvent {
  id         String            @id @default(cuid())
  bookingId  String
  booking    HotelBooking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus BookingStatus
  toStatus   BookingStatus
  reason     String?
  actor      BookingEventActor
  metadata   Json?
  createdAt  DateTime          @default(now())

  @@index([bookingId, createdAt])
}

/// Per-date fungible room-type availability (distinct from hotel supply InventoryItem).
model Inventory {
  id             String   @id @default(cuid())
  roomTypeId     String
  roomType       RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  date           DateTime @db.Date
  totalRooms     Int
  availableRooms Int
  version        Int      @default(0)

  @@unique([roomTypeId, date])
  @@index([roomTypeId, date, availableRooms])
}

model BookingGuest {
  id           String       @id @default(cuid())
  bookingId    String
  booking      HotelBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String?
  passportData String?      @db.Text
  nationality  String?
  birthDate    DateTime?
  isChild      Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([bookingId])
}

model RoomType {
  id                   String              @id @default(cuid())
  hotelId              String
  hotel                Hotel               @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  capacityAdults       Int                 @default(2)
  capacityChildren     Int                 @default(0)
  basePrice            Decimal             @db.Decimal(12, 2)
  isActive             Boolean             @default(true)
  amenities            Json?               @default("[]")
  images               Json?               @default("[]")
  cancellationPolicyId String?
  cancellationPolicy   CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  rooms                PhysicalRoom[]
  bookings             HotelBooking[]
  inventory            Inventory[]
  ratePlans            RatePlan[]

  @@index([hotelId, isActive])
  @@index([cancellationPolicyId])
}

model PhysicalRoom {
  id                String                  @id @default(cuid())
  hotelId           String
  hotel             Hotel                   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomTypeId        String
  roomType          RoomType                @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  roomNumber        String
  floor             String?
  status            RoomOperationalStatus   @default(AVAILABLE)
  isActive          Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  assignments       BookingRoomAssignment[]
  housekeepingTasks HousekeepingTask[]

  @@unique([hotelId, roomNumber])
  @@index([hotelId, roomTypeId, isActive, status])
}

model BookingRoomAssignment {
  id             String               @id @default(cuid())
  bookingId      String
  booking        HotelBooking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  physicalRoomId String
  physicalRoom   PhysicalRoom         @relation(fields: [physicalRoomId], references: [id], onDelete: Cascade)
  checkInDate    DateTime
  checkOutDate   DateTime
  status         RoomAssignmentStatus @default(ACTIVE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([physicalRoomId, checkInDate, checkOutDate, status])
  @@index([bookingId, status])
}

model TravelPlan {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination   String
  startDate     DateTime
  endDate       DateTime
  pax           Int
  status        TravelPlanStatus @default(DRAFT)
  totalAmount   Decimal          @default(0) @db.Decimal(12, 2)
  note          String?
  tourPackageId String?
  tourPackage   TourPackage?     @relation(fields: [tourPackageId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  items            TravelPlanItem[]
  payments         Payment[]
  homeStayBookings HomeStayBooking[]
  taxiOrders       TaxiOrder[]
  guideBookings    GuideBooking[]
  hotelBookings    HotelBooking[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([tourPackageId])
}

model TravelPlanItem {
  id           String         @id @default(cuid())
  travelPlanId String
  travelPlan   TravelPlan     @relation(fields: [travelPlanId], references: [id], onDelete: Cascade)
  type         TravelItemType
  title        String
  providerId   String?
  quantity     Int            @default(1)
  unitPrice    Decimal        @db.Decimal(12, 2)
  totalPrice   Decimal        @db.Decimal(12, 2)
  details      Json?
  createdAt    DateTime       @default(now())

  @@index([travelPlanId, type])
}

model Payment {
  id             String          @id @default(cuid())
  travelPlanId   String
  travelPlan     TravelPlan      @relation(fields: [travelPlanId], references: [id], onDelete: Cascade)
  provider       PaymentProvider @default(MOCK)
  status         PaymentStatus   @default(INITIATED)
  /// DEPRECATED (som Decimal) — prefer amountTiyin; kept until read paths migrate.
  amount         Decimal         @db.Decimal(12, 2)
  /// Money SoT in TIYIN (1 som = 100 tiyin).
  amountTiyin    BigInt
  currency       String          @default("UZS")
  idempotencyKey String?         @unique
  externalRef    String?
  metadata         Json?
  didoxDocumentId  String?
  paidAt           DateTime?
  createdAt        DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([travelPlanId, status])
}

model TaxiOrder {
  id                 String                @id @default(cuid())
  customerId         String
  customer           User                  @relation("TaxiOrderCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  driverId           String?
  driver             User?                 @relation("TaxiOrderDriver", fields: [driverId], references: [id], onDelete: SetNull)
  vehicleId          String?
  vehicle            Vehicle?              @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  serviceId          String?
  service            TaxiService?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  travelPlanId       String?
  travelPlan         TravelPlan?           @relation(fields: [travelPlanId], references: [id], onDelete: SetNull)
  pickupAddress      String
  dropoffAddress     String
  pickupLat          Float
  pickupLng          Float
  dropoffLat         Float
  dropoffLng         Float
  scheduledAt        DateTime?
  estimatedPrice     Decimal               @db.Decimal(10, 2)
  finalPrice         Decimal?              @db.Decimal(10, 2)
  distanceKm         Float?
  status             TaxiOrderStatus       @default(PENDING)
  cancelledBy        TaxiOrderCancelledBy?
  cancellationReason String?
  customerNote       String?
  driverNote         String?
  priceSnapshot      Json
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  logs    TaxiOrderLog[]
  review  TaxiReview?
  earning DriverEarning?

  @@index([customerId, status])
  @@index([driverId, status])
  @@index([vehicleId])
  @@index([serviceId])
  @@index([travelPlanId])
  @@index([status, createdAt])
}

model TaxiOrderLog {
  id         String    @id @default(cuid())
  orderId    String
  order      TaxiOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User      @relation(fields: [actorId], references: [id], onDelete: Cascade)
  actorRole  String
  fromStatus String
  toStatus   String
  note       String?
  createdAt  DateTime  @default(now())

  @@index([orderId, createdAt])
  @@index([actorId])
}

model TaxiReview {
  id         String    @id @default(cuid())
  orderId    String    @unique
  order      TaxiOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String
  customer   User      @relation("TaxiReviewCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  driverId   String
  driver     User      @relation("TaxiReviewDriver", fields: [driverId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  createdAt  DateTime  @default(now())

  @@index([customerId])
  @@index([driverId, rating])
}

model DriverEarning {
  id          String              @id @default(cuid())
  driverId    String
  driver      User                @relation(fields: [driverId], references: [id], onDelete: Cascade)
  orderId     String              @unique
  order       TaxiOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  grossAmount Decimal             @db.Decimal(10, 2)
  platformFee Decimal             @db.Decimal(10, 2)
  netAmount   Decimal             @db.Decimal(10, 2)
  status      DriverEarningStatus @default(PENDING)
  settledAt   DateTime?
  createdAt   DateTime            @default(now())

  @@index([driverId, status])
  @@index([createdAt])
}

model PartnerEarning {
  id             String               @id @default(cuid())
  partnerId      String
  /// Restrict: payout history must survive partner account cleanup.
  partner        User                 @relation("PartnerEarnings", fields: [partnerId], references: [id], onDelete: Restrict)
  bookingType    PartnerEarningType
  bookingId      String
  /// Money SoT in TIYIN (1 som = 100 tiyin). Never float/Decimal.
  grossTiyin         BigInt
  /// Integer percent 0..100 (see asRatePercent).
  commissionRate     Int
  commissionFeeTiyin BigInt
  netTiyin           BigInt
  status         PartnerEarningStatus @default(PENDING)
  paidAt         DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([bookingType, bookingId])
  @@index([partnerId])
  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  /// AuditLog's "user" column is actorId — admin screens filter by actor.
  @@index([actorId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  type      String    @default("info")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model TourPackage {
  id          String  @id @default(cuid())
  title       String
  description String  @db.Text
  destination String
  days        Int
  nights      Int
  price       Decimal @db.Decimal(12, 2)
  status      String  @default("active")
  category    String
  imageUrl    String?
  highlights  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  travelPlans TravelPlan[]

  @@index([status])
  @@index([category])
  @@index([destination])
}

model GuestProfile {
  id           String    @id @default(cuid())
  hotelId      String
  hotel        Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String?
  phone        String?
  email        String?
  passportData String?   @db.Text
  nationality  String?
  birthDate    DateTime?
  vipStatus    String    @default("REGULAR") // REGULAR, VIP
  totalVisits  Int       @default(0)
  totalSpent   Decimal   @default(0) @db.Decimal(12, 2)
  preferences  Json?
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([hotelId, vipStatus])
  @@index([phone])
}

model HotelGuest {
  id          String    @id @default(cuid())
  hotelId     String
  hotel       Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  fullName    String
  phone       String
  email       String?
  passportId  String?
  nationality String?
  birthDate   DateTime?
  gender      String?
  address     String?

  notes       String?   @db.Text
  isVip       Boolean   @default(false)
  isBlacklist Boolean   @default(false)

  visitCount  Int       @default(0)
  totalSpent  Decimal   @default(0) @db.Decimal(14, 2)

  bookings    HotelBooking[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([hotelId, phone])
  @@index([hotelId])
  @@index([phone])
}

model HousekeepingTask {
  id             String            @id @default(cuid())
  physicalRoomId String
  physicalRoom   PhysicalRoom      @relation(fields: [physicalRoomId], references: [id], onDelete: Cascade)
  hotelId        String
  staffId        String?
  staff          HotelStaff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  assigneeName   String? // Fallback or display name
  taskType       String            @default("CLEANING") // CLEANING, MAINTENANCE, INSPECTION
  status         String            @default("PENDING") // PENDING, IN_PROGRESS, DONE
  priority       String            @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  notes          String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  consumptions   TaskConsumption[]

  @@index([hotelId, status])
  @@index([physicalRoomId, status])
  @@index([staffId])
}

model TaskConsumption {
  id              String           @id @default(cuid())
  taskId          String
  task            HousekeepingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem    @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantity        Decimal          @db.Decimal(12, 2)
  notes           String?          @db.Text
  createdAt       DateTime         @default(now())

  @@index([taskId])
  @@index([inventoryItemId])
}

model HotelStaff {
  id        String   @id @default(cuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName String
  lastName  String?
  phone     String?
  role      String   @default("STAFF") // ADMIN, RECEPTION, CLEANER, MANAGER
  shift     String? // MORNING, EVENING, NIGHT
  salary    Decimal  @default(0) @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  housekeepingTasks HousekeepingTask[]
  staffShifts       StaffShift[]
  staffOpsTasks     StaffOpsTask[]
  courseEnrollments StaffCourseEnrollment[]

  @@index([hotelId, role])
  @@index([userId])
}

/// Scheduled work block for a staff member (property-scoped).
model StaffShift {
  id        String           @id @default(cuid())
  hotelId   String
  hotel     Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  staffId   String
  staff     HotelStaff       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  title     String
  location  String?
  startsAt  DateTime
  endsAt    DateTime
  status    StaffShiftStatus @default(SCHEDULED)
  notes     String?          @db.Text
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([hotelId, startsAt])
  @@index([staffId, startsAt])
  @@index([status, startsAt])
}

/// General ops task (HelloShift/HotSOS style). May optionally reference housekeeping.
model StaffOpsTask {
  id                 String               @id @default(cuid())
  hotelId            String
  hotel              Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  staffId            String?
  staff              HotelStaff?          @relation(fields: [staffId], references: [id], onDelete: SetNull)
  createdByUserId    String?
  createdBy          User?                @relation("StaffOpsTaskCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  title              String
  description        String?              @db.Text
  department         String?
  priority           StaffOpsTaskPriority @default(NORMAL)
  status             StaffOpsTaskStatus   @default(PENDING)
  dueAt              DateTime?
  /// Soft link to existing HousekeepingTask (no cross-module join required).
  housekeepingTaskId String?
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([hotelId, status])
  @@index([staffId, status])
  @@index([hotelId, dueAt])
}

/// Property chat thread (department / DM / announcement) — Unifocus/hotelkit pattern.
model StaffChatThread {
  id         String              @id @default(cuid())
  hotelId    String
  hotel      Hotel               @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name       String
  kind       StaffChatThreadKind @default(DEPARTMENT)
  department String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  members  StaffChatMember[]
  messages StaffChatMessage[]

  @@index([hotelId, kind])
  @@unique([hotelId, kind, department])
}

model StaffChatMember {
  id         String         @id @default(cuid())
  threadId   String
  thread     StaffChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?
  joinedAt   DateTime       @default(now())

  @@unique([threadId, userId])
  @@index([userId])
}

/// Immutable chat messages (append-only).
model StaffChatMessage {
  id           String         @id @default(cuid())
  threadId     String
  thread       StaffChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorUserId String
  author       User           @relation("StaffChatMessageAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  body         String         @db.Text
  createdAt    DateTime       @default(now())

  @@index([threadId, createdAt])
  @@index([authorUserId])
}

/// Micro-learning catalog (Weldon / 7shifts training pattern).
model StaffCourse {
  id          String   @id @default(cuid())
  /// null = platform-wide catalog; set = hotel-specific SOP course
  hotelId     String?
  hotel       Hotel?   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  category    String   @default("STANDARDS")
  durationMin Int      @default(15)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules     StaffCourseModule[]
  enrollments StaffCourseEnrollment[]

  @@index([hotelId, isPublished])
  @@index([category])
}

model StaffCourseModule {
  id        String      @id @default(cuid())
  courseId  String
  course    StaffCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sortOrder Int         @default(0)
  title     String
  body      String?     @db.Text
  videoUrl  String?
  createdAt DateTime    @default(now())

  progress StaffModuleProgress[]

  @@index([courseId, sortOrder])
}

model StaffCourseEnrollment {
  id          String      @id @default(cuid())
  courseId    String
  course      StaffCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffId     String?
  staff       HotelStaff? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  progressPct Int         @default(0)
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  moduleProgress StaffModuleProgress[]

  @@unique([courseId, userId])
  @@index([userId])
  @@index([staffId])
}

model StaffModuleProgress {
  id           String               @id @default(cuid())
  enrollmentId String
  enrollment   StaffCourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  moduleId     String
  module       StaffCourseModule    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  completed    Boolean              @default(false)
  completedAt  DateTime?

  @@unique([enrollmentId, moduleId])
  @@index([moduleId])
}

model FolioItem {
  id          String       @id @default(cuid())
  bookingId   String
  booking     HotelBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotelId     String
  category    String       @default("ROOM") // ROOM, MINIBAR, RESTAURANT, DAMAGES
  description String
  /// DEPRECATED (som Decimal) — prefer amountTiyin; kept until read paths migrate.
  amount      Decimal      @db.Decimal(12, 2)
  /// Money SoT in TIYIN (1 som = 100 tiyin). Backfilled from amount.
  amountTiyin BigInt?
  isPaid      Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@index([bookingId])
  @@index([hotelId])
}

model HotelPayment {
  id          String       @id @default(cuid())
  bookingId   String
  booking     HotelBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotelId     String
  /// DEPRECATED (som Decimal) — prefer amountTiyin; kept until read paths migrate.
  amount      Decimal      @db.Decimal(12, 2)
  /// Money SoT in TIYIN (1 som = 100 tiyin). Backfilled from amount.
  amountTiyin BigInt?
  method      String       @default("CASH") // CASH, CARD, TRANSFER
  status      String       @default("COMPLETED")
  receiptUrl  String?
  createdAt   DateTime     @default(now())

  @@index([bookingId])
  @@index([hotelId])
}

model InventoryCategory {
  id      String @id @default(cuid())
  hotelId String
  hotel   Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name    String @unique

  @@index([hotelId])
}

model InventoryItem {
  id                   String   @id @default(cuid())
  hotelId              String
  hotel                Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name                 String
  category             String   @default("GENERAL")
  unit                 String   @default("PCS")
  quantity             Decimal  @default(0) @db.Decimal(12, 2)
  minQuantity          Decimal  @default(0) @db.Decimal(12, 2)
  isHousekeepingSupply Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  transactions InventoryTransaction[]
  consumptions TaskConsumption[]

  @@index([hotelId, category])
}

model InventoryTransaction {
  id              String        @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  hotelId         String
  type            String        @default("IN") // IN, OUT
  quantity        Decimal       @db.Decimal(12, 2)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())

  @@index([inventoryItemId])
  @@index([hotelId])
}

model MenuItem {
  id          String   @id @default(cuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  category    String   @default("GENERAL") // STARTER, MAIN, DRINK, DESSERT
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([hotelId, category])
}

model RestaurantOrder {
  id              String   @id @default(cuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  bookingId       String? // Optional link to guest room folio
  tableNumber     String?
  items           Json // List of items ordered
  totalAmount     Decimal  @db.Decimal(12, 2)
  status          String   @default("PENDING") // PENDING, SERVED, CANCELLED
  isChargedToRoom Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([hotelId, status])
  @@index([bookingId])
}

model GuestFeedback {
  id        String   @id @default(cuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guestName String
  rating    Int      @default(5)
  comment   String?  @db.Text
  source    String   @default("DIRECT") // DIRECT, TRIPADVISOR, GOOGLE
  createdAt DateTime @default(now())

  @@index([hotelId, rating])
}

model HomeStayListing {
  id               String                @id @default(cuid())
  hostId           String
  host             User                  @relation(fields: [hostId], references: [id], onDelete: Cascade)
  partnerId        String?
  partner          HomeSayPartner?       @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  /// PLATFORM = company-operated listing (no PartnerEarning on payment).
  ownerType        PayoutOwnerType       @default(PARTNER)
  title            String
  description      String
  address          String
  city             String
  region           String
  // Coordinates are required at the API layer (see homestay host listings
  // route) so taxi/discovery features can match nearby places.
  // Stored as nullable to avoid breaking legacy rows; new/edited rows must
  // supply valid lat/lng.
  latitude         Float?
  longitude        Float?
  pricePerNight    Decimal               @db.Decimal(10, 2)
  maxGuests        Int
  rooms            Int
  beds             Int
  bathrooms        Int
  amenities        Json                  @default("[]")
  images           Json                  @default("[]")
  status           HomeStayListingStatus @default(PENDING)
  verificationNote String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  availabilities HomeStayAvailability[]
  bookings       HomeStayBooking[]
  reviews        HomeStayReview[]

  @@index([hostId, status])
  @@index([city, status])
  @@index([partnerId])
  @@index([latitude, longitude])
}

model HomeStayAvailability {
  id        String                     @id @default(cuid())
  listingId String
  listing   HomeStayListing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bookingId String?                    @unique
  booking   HomeStayBooking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  startDate DateTime
  endDate   DateTime
  reason    HomeStayAvailabilityReason
  createdAt DateTime                   @default(now())

  @@index([listingId, startDate, endDate])
  @@index([reason])
}

model HomeStayBooking {
  id                 String                @id @default(cuid())
  listingId          String
  listing            HomeStayListing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  travelPlanId       String?
  travelPlan         TravelPlan?           @relation(fields: [travelPlanId], references: [id], onDelete: SetNull)
  guestId            String
  guest              User                  @relation(fields: [guestId], references: [id], onDelete: Cascade)
  checkIn            DateTime
  checkOut           DateTime
  nights             Int
  guestCount         Int
  totalPrice         Decimal               @db.Decimal(10, 2)
  priceSnapshot      Json
  status             HomeStayBookingStatus @default(PENDING)
  holdExpiresAt      DateTime?
  cancellationReason String?
  guestNote          String?
  hostNote           String?
  /// Stamped from HomeStayListing.ownerType at successful payment.
  payoutOwnerType    PayoutOwnerType       @default(PARTNER)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  review       HomeStayReview?
  availability HomeStayAvailability?
  logs         HomeStayBookingLog[]

  @@index([listingId, status])
  @@index([guestId, status])
  @@index([travelPlanId, status])
  @@index([checkIn, checkOut])
  @@index([status, holdExpiresAt])
}

model HomeStayBookingLog {
  id         String          @id @default(cuid())
  bookingId  String
  booking    HomeStayBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole  String
  fromStatus String
  toStatus   String
  note       String?
  createdAt  DateTime        @default(now())

  @@index([bookingId, createdAt])
  @@index([actorId])
}

model Booking {
  id              String          @id @default(cuid())
  userId          String
  hotelId         String
  amount          Int
  status          String          @default("PENDING")
  checkInDate     DateTime?
  checkOutDate    DateTime?
  /// Stamped from Hotel.ownerType at Payme perform (legacy path).
  payoutOwnerType PayoutOwnerType @default(PARTNER)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user             User              @relation("PaymeBookings", fields: [userId], references: [id], onDelete: Cascade)
  hotel            Hotel             @relation("PaymeBookings", fields: [hotelId], references: [id], onDelete: Cascade)
  paymeTransaction PaymeTransaction?

  @@index([userId, status])
  @@index([hotelId, status])
  @@index([payoutOwnerType])
}

model PaymeTransaction {
  id          String   @id @default(cuid())
  paymeId     String   @unique
  paymeTime   BigInt
  bookingId   String   @unique
  state       Int      @default(1)
  amount      Int
  reason      Int?
  performTime BigInt?
  cancelTime  BigInt?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([paymeTime])
  @@index([state])
}

model HomeStayReview {
  id        String          @id @default(cuid())
  bookingId String          @unique
  booking   HomeStayBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  guestId   String
  guest     User            @relation(fields: [guestId], references: [id], onDelete: Cascade)
  listingId String
  listing   HomeStayListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime        @default(now())

  @@index([guestId])
  @@index([listingId, rating])
}

// --- Payment hardening (additive) ---

model PaymentTransaction {
  id              String   @id @default(cuid())
  provider        String // PAYME | CLICK
  idempotencyKey  String   @unique
  amountTiyin     BigInt
  currency        String   @default("UZS")
  status          String // INITIATED | PENDING | SUCCESS | FAILED | CANCELLED
  bookingId       String? // HotelBooking id when applicable
  travelPlanId    String?
  legacyPaymentId String? // link to existing Payment.id
  externalRef     String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([provider, externalRef])
  @@index([legacyPaymentId])
  @@index([status])
}

/// Idempotent webhook responses — never mutate; duplicates return responseJson.
model ProcessedEvent {
  id              String   @id @default(cuid())
  provider        String // PAYME | CLICK
  providerEventId String
  payloadHash     String
  responseJson    Json
  processedAt     DateTime @default(now())

  @@unique([provider, providerEventId])
}

/// Append-only inbound webhook audit (no updates in app code).
model WebhookLog {
  id         String   @id @default(cuid())
  provider   String
  path       String
  headers    Json
  rawBody    String   @db.LongText
  verified   Boolean?
  resultNote String?
  createdAt  DateTime @default(now())

  @@index([provider, createdAt])
}

// --- Minimal double-entry ledger (tiyin, immutable entries) ---

enum AccountType {
  ASSET
  LIABILITY
  REVENUE
  EQUITY
}

model LedgerAccount {
  id        String      @id @default(cuid())
  type      AccountType
  ownerType String // PLATFORM | PARTNER | GUEST
  ownerId   String // "" for PLATFORM
  currency  String      @default("UZS")
  createdAt DateTime    @default(now())
  entries   LedgerEntry[]

  @@unique([ownerType, ownerId, type, currency])
}

model LedgerTransaction {
  id                    String              @id @default(cuid())
  bookingId             String?
  /// Booking vertical for platform-fee / payable attribution (reuses PartnerEarningType).
  /// Null only for legacy/unresolvable rows (e.g. payout without booking).
  bookingType           PartnerEarningType?
  type                  String // BOOKING_PAYMENT | COMMISSION | PAYOUT | REFUND | ADJUSTMENT
  idempotencyKey        String              @unique
  reversesTransactionId String?
  createdAt             DateTime            @default(now())
  entries               LedgerEntry[]

  @@index([bookingType, createdAt])
}

/// Immutable: never UPDATE/DELETE LedgerEntry rows — compensate with a reversing LedgerTransaction.
model LedgerEntry {
  id            String            @id @default(cuid())
  transactionId String
  /// Restrict: entries are immutable, so deleting the parent transaction must
  /// not silently take the double-entry rows with it.
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId     String
  account       LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  amount        BigInt // TIYIN, always > 0
  direction     String // DEBIT | CREDIT
  createdAt     DateTime          @default(now())

  @@index([accountId])
  @@index([transactionId])
}

// --- Rates / pricing (additive, tiyin) ---

enum RatePlanType {
  BASE
  DERIVED
  INDEPENDENT
}

model CancellationPolicy {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  rules     CancellationRule[]
  roomTypes RoomType[]
  bookings  HotelBooking[]
  ratePlans RatePlan[]
  createdAt DateTime           @default(now())
}

model CancellationRule {
  id                 String             @id @default(cuid())
  policyId           String
  policy             CancellationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  /// Match when hoursRemaining >= this threshold (and conditions).
  hoursBeforeCheckIn Int
  /// 0..100
  refundPercent      Int
  /// Optional predicates, e.g. { maxHoursSinceBooking, minHoursBeforeCheckIn }
  conditions         Json?

  @@index([policyId, hoursBeforeCheckIn])
}

model RatePlan {
  id                   String              @id @default(cuid())
  roomTypeId           String
  roomType             RoomType            @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  name                 String
  type                 RatePlanType
  /// Nightly base for BASE plans (tiyin).
  basePriceTiyin       BigInt?
  derivedFromId        String?
  derivedFrom          RatePlan?           @relation("RatePlanDerivation", fields: [derivedFromId], references: [id], onDelete: SetNull)
  derivedPlans         RatePlan[]          @relation("RatePlanDerivation")
  adjustmentType       String? // PERCENT | FIXED
  adjustmentValueTiyin BigInt? // FIXED: tiyin delta
  adjustmentBps        Int? // PERCENT: e.g. 1000 = 10%
  cancellationPolicyId String?
  cancellationPolicy   CancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id], onDelete: SetNull)
  isActive             Boolean             @default(true)
  overrides            RateOverride[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([roomTypeId, isActive])
  @@index([roomTypeId, type])
}

model RateOverride {
  id         String   @id @default(cuid())
  ratePlanId String
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  priceTiyin BigInt
  minLos     Int?

  @@index([ratePlanId, startDate, endDate])
}

model Promotion {
  id               String    @id @default(cuid())
  code             String?   @unique
  name             String
  /// PERCENT_BPS | FIXED_TIYIN
  discountType     String
  discountValue    BigInt
  stackGroup       String
  priority         Int
  /// string[] of stackGroup ids allowed together; empty = none
  combinableWith   Json      @default("[]")
  maxDiscountTiyin BigInt?
  activeFrom       DateTime?
  activeTo         DateTime?
  isActive         Boolean   @default(true)
}

model TaxFeeRule {
  id        String  @id @default(cuid())
  name      String
  /// PERCENT_BPS | FIXED_TIYIN_PER_NIGHT | FIXED_TIYIN_PER_STAY
  type      String
  value     BigInt
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

model OccupancyRule {
  id         String  @id @default(cuid())
  ratePlanId String?
  roomTypeId String?
  rules      Json
  isActive   Boolean @default(true)
}

model LosRule {
  id         String  @id @default(cuid())
  ratePlanId String?
  minLos     Int?
  maxLos     Int?
  /// e.g. [{ minNights, discountBps }]
  tiers      Json
  isActive   Boolean @default(true)
}

// --- Transactional outbox ---

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

model OutboxEvent {
  id            String       @id @default(cuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now())
  createdAt     DateTime     @default(now())
  sentAt        DateTime?
  lastError     String?      @db.Text

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@index([eventType, status])
}

/// Idempotency keys for outbox consumers (at-least-once relay).
model OutboxProcessedKey {
  id        String   @id @default(cuid())
  consumer  String
  key       String
  createdAt DateTime @default(now())

  @@unique([consumer, key])
}

// ---------------------------------------------------------------------------
// Knowledge base (SafarAI / trip builder / guide accuracy) — NEW MODELS ONLY
// Locked names: Site, ClaimLevel, deriveClaimLevel, Source, ClaimSource
// ---------------------------------------------------------------------------

enum SiteCategory {
  OBIDA
  MADRASA
  MASJID
  MAQBARA
  MUZEY
  ARXEOLOGIYA
  TABIAT
  BOZOR
  ZIYORATGOH
  BOSHQA
  RESTORAN
  CHAYXONA
  KAFE
}

enum SiteStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

/// Planner ranking: PRIMARY first, then SECONDARY, then OPTIONAL / null (lowest).
enum SiteProminence {
  PRIMARY
  SECONDARY
  OPTIONAL
}

enum ClaimKind {
  TARIX
  ARXITEKTURA
  AMALIY
  NARX
  RIVOYAT
}

enum ClaimLevel {
  TASDIQLANGAN
  ILMIY_MANBA
  NIZOLI
  OGZAKI_RIVOYAT
  TASDIQLANMAGAN
}

enum SourceTier {
  A_RASMIY
  B_ILMIY
  C_ENSIKLOPEDIK
  D_IKKILAMCHI
}

/// Place of interest for the knowledge base (not booking inventory).
model Site {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  nameRu       String?
  nameEn       String?
  regionCode   String
  districtCode String?
  category     SiteCategory
  lat          Float?
  lng          Float?
  /// Opening hours for planners + optional intake provenance.
  /// Shape: {
  ///   "weekly": { "mon": [["09:00","19:00"]], "tue": [...], "sun": [] },
  ///   "raw": "Du-Ju 07:00 - 22:00, Sh-Ya 09:00 - 22:00",
  ///   "closedDates": ["2026-09-01"],
  ///   "seasonal": [{ "from": "11-01", "to": "03-01",
  ///                  "weekly": { "mon": [["09:00","17:00"]] } }]
  /// }
  openingHours Json?
  /// Dining metadata for RESTORAN / CHAYXONA / KAFE — null for non-dining sites.
  /// Do NOT store an average price as a number (goes stale; not the pricing system).
  /// Shape: {
  ///   "cuisine": ["uzbek","evropa"],
  ///   "priceBand": "arzon" | "orta" | "qimmat",
  ///   "mealTypes": ["nonushta","tushlik","kechki"],
  ///   "mustTry": ["samarqand oshi","shashlik"],
  ///   "note": "Palov tushda tayyorlanadi, 15:00 dan keyin tugaydi"
  /// }
  dining       Json?
  /// Provenance URL for the seed / intake row. Empty ⇒ must stay DRAFT.
  sourceUrl    String?
  /// Trip-plan ranking. Null ⇒ treated as OPTIONAL (lowest).
  prominence   SiteProminence?
  status       SiteStatus   @default(DRAFT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  claims  Claim[]
  reports AccuracyReport[]

  @@index([regionCode, districtCode, status])
  @@index([regionCode, status, prominence])
}

model Claim {
  id              String     @id @default(cuid())
  siteId          String
  site            Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  text            String     @db.Text
  kind            ClaimKind
  /// DERIVED via deriveClaimLevel unless levelLockedBy is set.
  level           ClaimLevel @default(TASDIQLANMAGAN)
  levelLockedBy   String?
  levelLockedNote String?    @db.Text
  version         Int        @default(1)
  checkedAt       DateTime?
  recheckAfter    DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sources   ClaimSource[]
  positions ClaimPosition[]
  reports   AccuracyReport[]

  @@index([siteId, level])
  @@index([recheckAfter])
}

/// Canonical open-source citation. Reused across many claims via ClaimSource.
model Source {
  id           String     @id @default(cuid())
  tier         SourceTier
  publisher    String
  /// Normalized publisher for independence checks (see normalizePublisherKey).
  publisherKey String
  title        String
  url          String?
  citation     String     @db.Text
  retrievedAt  DateTime
  deadSince    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  claims ClaimSource[]

  @@index([publisherKey, tier])
}

model ClaimPosition {
  id        String   @id @default(cuid())
  claimId   String
  claim     Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  text      String   @db.Text
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sources ClaimSource[] @relation("ClaimPositionSources")

  @@index([claimId])
}

model ClaimSource {
  id                 String         @id @default(cuid())
  claimId            String
  claim              Claim          @relation(fields: [claimId], references: [id], onDelete: Cascade)
  sourceId           String
  source             Source         @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  quote              String?        @db.Text
  supportsPositionId String?
  position           ClaimPosition? @relation("ClaimPositionSources", fields: [supportsPositionId], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now())

  @@unique([claimId, sourceId])
  @@index([sourceId])
  @@index([claimId])
}

/// Tourist / guide accuracy complaint → knowledge-base intake queue.
model AccuracyReport {
  id             String    @id @default(cuid())
  /// OPEN | IN_REVIEW | LINKED | NEW_CLAIM | DISMISSED
  status         String    @default("OPEN")
  message        String    @db.Text
  /// Guide person (GuideListing.hostId), not a listing.
  guideUserId    String?
  regionCode     String?
  siteId         String?
  site           Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  claimId        String?
  claim          Claim?    @relation(fields: [claimId], references: [id], onDelete: SetNull)
  reporterUserId String?
  /// null = not reviewed; true = upheld; false = rejected.
  upheld         Boolean?
  reviewNote     String?   @db.Text
  reviewedAt     DateTime?
  reviewedBy     String?
  createdAt      DateTime  @default(now())

  @@index([status, createdAt])
  @@index([guideUserId, upheld])
  @@index([regionCode])
}

/// Support inbox ticket — one row per guest review/feedback (idempotent via source).
model FeedbackTicket {
  id            String               @id @default(cuid())
  channel       FeedbackChannel
  /// GuideReview | TaxiReview | HomeStayReview | GuestFeedback | Direct
  sourceType    String
  sourceId      String
  authorUserId  String?
  authorName    String
  rating        Int
  body          String               @db.Text
  serviceLabel  String?
  /// Hotel / listing / partner entity id (display/filter only — no cross joins).
  subjectId     String?
  status        FeedbackTicketStatus @default(OPEN)
  sentiment     FeedbackSentiment
  category      String?
  assignedToId  String?
  assignedTo    User?                @relation("FeedbackTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  repliedAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  replies FeedbackReply[]

  @@unique([sourceType, sourceId])
  @@index([status, createdAt])
  @@index([channel, rating])
  @@index([sentiment, createdAt])
  @@index([assignedToId])
}

/// Immutable support replies (corrections = new reply, never UPDATE body).
model FeedbackReply {
  id           String   @id @default(cuid())
  ticketId     String
  ticket       FeedbackTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUserId String
  author       User     @relation("FeedbackReplyAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  body         String   @db.Text
  createdAt    DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([authorUserId])
}

/// Live support chat: hotel / homestay / taxi / guide / customer ↔ support agent.
model SupportThread {
  id            String              @id @default(cuid())
  subject       String
  partyType     SupportPartyType
  partyUserId   String
  partyUser     User                @relation("SupportThreadParty", fields: [partyUserId], references: [id], onDelete: Cascade)
  status        SupportThreadStatus @default(OPEN)
  lastMessageAt DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  members  SupportThreadMember[]
  messages SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([partyUserId, status])
  @@index([partyType, status])
}

model SupportThreadMember {
  id         String            @id @default(cuid())
  threadId   String
  thread     SupportThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       SupportMemberRole
  lastReadAt DateTime?
  joinedAt   DateTime          @default(now())

  @@unique([threadId, userId])
  @@index([userId])
}

/// Immutable support chat messages (append-only).
model SupportMessage {
  id           String        @id @default(cuid())
  threadId     String
  thread       SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorUserId String
  author       User          @relation("SupportMessageAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  body         String        @db.Text
  createdAt    DateTime      @default(now())

  @@index([threadId, createdAt])
  @@index([authorUserId])
}

// ---------------------------------------------------------------------------
// Hotel integrations + invoices + channel (OTA) — SiteMinder/Cloudbeds-style
// ---------------------------------------------------------------------------

enum IntegrationCategory {
  OTA
  PAYMENT
  LOCAL
}

enum IntegrationConnectionStatus {
  DISCONNECTED
  PENDING
  CONNECTED
  LICENSE_REQUIRED
  ERROR
}

enum HotelInvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PAID
  VOID
}

enum ChannelSyncKind {
  ARI_PUSH
  RESERVATION_PULL
  FULL_REFRESH
  MAPPING_PULL
}

enum ChannelSyncJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ChannelReservationInboxStatus {
  RECEIVED
  MAPPED
  BOOKING_CREATED
  IGNORED
  FAILED
}

/// Per-hotel connection to an external provider (OTA / payment / local).
/// Secrets live in credentialsEnc — never expose via API responses.
model HotelIntegration {
  id              String                       @id @default(cuid())
  hotelId         String
  hotel           Hotel                        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  /// Stable catalog key: booking | expedia | airbnb | payme | click | uzum | yandex | guides
  providerKey     String
  category        IntegrationCategory
  status          IntegrationConnectionStatus  @default(DISCONNECTED)
  externalHotelId String?
  /// Non-secret config (flags, property codes).
  configJson      Json?
  /// Opaque credential blob (encrypt at rest in production). Never return raw.
  credentialsEnc  String?                      @db.Text
  lastSyncAt      DateTime?
  lastError       String?                      @db.Text
  meta            String?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@unique([hotelId, providerKey])
  @@index([hotelId, category])
  @@index([status])
}

/// Property B2B / guest invoice (separate from platform Payment Didox factura).
/// All money fields are TIYIN BigInt.
model HotelInvoice {
  id              String             @id @default(cuid())
  hotelId         String
  hotel           Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  /// Human number unique per hotel, e.g. INV-2026-0001
  number          String
  status          HotelInvoiceStatus @default(DRAFT)
  /// Optional HotelBooking id (no Prisma join — compose in service layer).
  bookingId       String?
  clientName      String
  clientAddress   String?
  clientCity      String?
  clientCountry   String?            @default("O‘zbekiston")
  clientTin       String?
  project         String?
  terms           String?            @db.Text
  notes           String?            @db.Text
  currency        String             @default("UZS")
  /// VAT in basis points (800 = 8%).
  vatRateBps      Int                @default(800)
  subtotalTiyin   BigInt             @default(0)
  vatTiyin        BigInt             @default(0)
  totalTiyin      BigInt             @default(0)
  issuedAt        DateTime?
  dueAt           DateTime?
  paidAt          DateTime?
  didoxDocumentId String?
  createdByUserId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  lines HotelInvoiceLine[]

  @@unique([hotelId, number])
  @@index([hotelId, status, createdAt])
  @@index([bookingId])
}

model HotelInvoiceLine {
  id              String       @id @default(cuid())
  invoiceId       String
  invoice         HotelInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sortOrder       Int          @default(0)
  name            String
  description     String?
  quantity        Int          @default(1)
  unitPriceTiyin  BigInt
  lineTotalTiyin  BigInt

  @@index([invoiceId, sortOrder])
}

/// Maps internal RoomType (+ optional rate plan) → OTA room/rate codes.
model ChannelRoomMapping {
  id               String   @id @default(cuid())
  hotelId          String
  hotel            Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  providerKey      String
  roomTypeId       String
  externalRoomCode String
  externalRateCode String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([hotelId, providerKey, roomTypeId, externalRateCode], map: "ChannelRoomMapping_hotel_provider_room_rate_key")
  @@index([hotelId, providerKey, active])
}

/// Outbound ARI / pull jobs — external HTTP only outside DB transactions.
model ChannelSyncJob {
  id           String                @id @default(cuid())
  hotelId      String
  hotel        Hotel                 @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  providerKey  String
  kind         ChannelSyncKind
  status       ChannelSyncJobStatus  @default(QUEUED)
  payloadJson  Json?
  resultJson   Json?
  errorMessage String?               @db.Text
  attempts     Int                   @default(0)
  scheduledAt  DateTime              @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime              @default(now())

  @@index([hotelId, status, scheduledAt])
  @@index([providerKey, status])
}

/// Inbound OTA reservations — idempotent by external id before booking create.
model ChannelReservationInbox {
  id                    String                         @id @default(cuid())
  hotelId               String
  hotel                 Hotel                          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  providerKey           String
  externalReservationId String
  status                ChannelReservationInboxStatus  @default(RECEIVED)
  payloadJson           Json
  /// Set when a HotelBooking is created from this inbox row.
  hotelBookingId        String?
  errorMessage          String?                        @db.Text
  receivedAt            DateTime                       @default(now())
  processedAt           DateTime?

  @@unique([hotelId, providerKey, externalReservationId], map: "ChannelReservationInbox_hotel_provider_extRes_key")
  @@index([hotelId, status, receivedAt])
}
