{
  "name": "safar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node --project tsconfig.server.json server.ts",
    "postinstall": "prisma generate",
    "prebuild": "node -e \"try{require('fs').rmSync('.next/standalone',{recursive:true,force:true})}catch(e){}\" && prisma generate",
    "build": "next build --webpack",
    "copy:standalone": "shx cp -r .next/static .next/standalone/.next/static && shx cp -r public .next/standalone/public && shx cp .env .next/standalone/.env && shx cp -r node_modules/@img .next/standalone/node_modules/next/node_modules/@img",
    "sync-sharp-standalone": "node scripts/sync-sharp-standalone.mjs",
    "build:standalone": "next build --webpack && npm run sync-sharp-standalone",
    "start": "cross-env NODE_ENV=production ts-node --project tsconfig.server.json server.ts",
    "start:prod": "node .next/standalone/server.js",
    "lint": "eslint .",
    "deploy": "bash scripts/deploy.sh",
    "deploy:safe": "bash scripts/deploy-safe.sh",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed-test-data.ts",
    "seed:knowledge": "tsx prisma/seed/knowledge.ts",
    "db:fix-partners": "tsx scripts/fix-missing-partners.ts",
    "db:inspect-homestay": "tsx scripts/inspect-homestay-user.ts",
    "db:approve-pending-homestays": "tsx scripts/approve-pending-homestays.ts",
    "db:inspect-user": "tsx scripts/inspect-user.ts",
    "db:backfill-inventory": "tsx scripts/backfill-inventory.ts",
    "db:backfill-rate-plans": "tsx scripts/backfill-rate-plans.ts",
    "db:seed-cancellation-policies": "tsx scripts/seed-cancellation-policies.ts",
    "db:backup": "bash scripts/backup.sh",
    "db:restore-test": "bash scripts/restore-test.sh",
    "expire-holds": "tsx scripts/expire-booking-holds.ts",
    "outbox:relay": "tsx scripts/outbox-relay.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run integration.test",
    "test:p0-ledger": "node --experimental-strip-types scripts/p0-ledger-check.mts",
    "db:reconcile-ledger": "tsx scripts/reconcile-ledger.ts",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "test:db:reset": "tsx scripts/reset-test-db.ts",
    "generate:expo-assets": "node scripts/generate-safartrip-assets.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.68.0",
    "autoprefixer": "^10.4.27",
    "bcryptjs": "^3.0.3",
    "didox": "^1.0.6",
    "expo-server-sdk": "^6.1.0",
    "jose": "^6.2.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "postcss": "^8.5.8",
    "react": "19.2.4",
    "react-datepicker": "^9.1.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.3",
    "sonner": "^2.0.7",
    "swiper": "^12.1.3",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "prisma": "^6.19.3",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
