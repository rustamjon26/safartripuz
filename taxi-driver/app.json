{
  "expo": {
    "name": "SafarTrip Haydovchi",
    "slug": "safartrip-driver",
    "version": "1.0.0",
    "scheme": "safartrip-driver",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1F4E79"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.safartrip.driver",
      "buildNumber": "1"
    },
    "android": {
      "package": "uz.safartrip.driver",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CALL_PHONE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "$(GOOGLE_MAPS_API_KEY)"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F4E79"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#3B82F6",
      "androidMode": "default"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SafarTrip taxi buyurtmasi uchun joylashuvingiz kerak.",
          "locationWhenInUsePermission": "SafarTrip taxi buyurtmasi uchun joylashuvingiz kerak.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "react-native-maps",
        {
          "googleMapsApiKey": "$(GOOGLE_MAPS_API_KEY)"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#3B82F6",
          "sounds": [],
          "mode": "production"
        }
      ]
    ]
  }
}
